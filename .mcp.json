{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@colbymchenry/codegraph@1.6.0",
        "serve",
        "--mcp"
      ]
    },
    "job-assistant": {
      "type": "stdio",
      "command": "backend/.venv/Scripts/python.exe",
