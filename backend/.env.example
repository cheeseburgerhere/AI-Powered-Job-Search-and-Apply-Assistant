# AI provider: anthropic | gemini | qwen
# For free/cheap testing, try:
#   AI_PROVIDER=gemini with gemini-2.0-flash
#   AI_PROVIDER=qwen with qwen-plus (fast) / qwen-max (quality)
AI_PROVIDER=anthropic

# Optional model overrides (leave blank to use provider defaults)
AI_MODEL_GENERAL=
AI_MODEL_FAST=

ANTHROPIC_API_KEY=sk-ant-xxxxx
GEMINI_API_KEY=your-google-ai-api-key
QWEN_API_KEY=your-qwen-api-key
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

JSEARCH_API_KEY=your-rapidapi-key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# Google Custom Search Engine — for Scrape Search (Greenhouse, Lever, Ashby etc.)
# Setup (free, 100 queries/day):
#   1. Create an API key: https://console.cloud.google.com/apis/credentials
#      Enable "Custom Search API" for that key.
#   2. Create a Search Engine: https://programmablesearchengine.google.com/
#      Set it to "Search the entire web". Copy the cx= value.
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-cse-cx-value
# Auto-find uses JSearch/Adzuna keys above. Add at least one provider key.
DATABASE_URL=sqlite:///./data/app.db
