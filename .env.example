# AI Provider Configuration
AI_PROVIDER=qwen
AI_MODEL_GENERAL=claude-3-5-sonnet-20241022
AI_MODEL_FAST=claude-3-5-haiku-20241022

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Alternative AI Providers (optional)
GEMINI_API_KEY=
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Job Search APIs
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_API_KEY=
BRAVE_API_KEY=

# Database
DATABASE_URL=sqlite:///./data/app.db

# Frontend Configuration (for Docker)
VITE_API_BASE_URL=http://localhost:8000


#openrouter use case
# Tell the app to use the qwen "channel"
AI_PROVIDER=qwen
# Provide OpenRouter endpoints and tokens
QWEN_API_BASE=https://openrouter.ai/api/v1
QWEN_API_KEY=your_openrouter_api_key
# Set the exact OpenRouter models you want to use
AI_MODEL_GENERAL=anthropic/claude-3.5-sonnet  # Or any other model on OpenRouter!
AI_MODEL_FAST=google/gemini-2.5-flash
